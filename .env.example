# Copy to ~/.kimi-agent/.env (or a .env in the directory you run kimi-agent from) and fill in what you use.
# Variables that are already set in the environment take precedence.

# Kimi / Moonshot AI (providers kimi, kimi-cn). MOONSHOT_API_KEY works too.
KIMI_API_KEY=

# Kimi Code subscription (provider kimi-code)
# KIMI_CODE_API_KEY=

# Other providers
# OPENROUTER_API_KEY=
# HF_TOKEN=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# DEEPSEEK_API_KEY=

# Web search (optional: DuckDuckGo is used when none is set)
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SEARXNG_URL=http://localhost:8888

# Any setting can be given as KIMI_AGENT_<SETTING>, for example:
# KIMI_AGENT_PROVIDER=openrouter
# KIMI_AGENT_MODEL=moonshotai/kimi-k3
# KIMI_AGENT_APPROVAL=auto
# KIMI_AGENT_PLUGINS=/path/to/my_tools.py

# Desktop app: the browser that shows its window (default: Edge, Chrome, Brave or Chromium, else your default
# browser). Use a Chromium-based browser, which can open app windows without tabs or an address bar.
# KIMI_AGENT_BROWSER=/usr/bin/vivaldi
